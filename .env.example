# LLM opcional para sustituir gradualmente las plantillas deterministas.
# Mientras LLM_ENABLED=false, el MVP funciona sin ninguna API externa.
LLM_ENABLED=false

# Perfil activo: groq, gemini o university.
# Si usas LLM_PROFILE, no necesitas tocar LLM_BASE_URL/LLM_API_KEY/LLM_MODEL.
LLM_PROFILE=groq
LLM_PROVIDER=openai-compatible

# Opcion A: configurar por perfil.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
UNIVERSITY_API_KEY=your_university_key_here
UNIVERSITY_BASE_URL=https://w1.etsisi.upm.es/vllm/v1
UNIVERSITY_MODEL=openai/gpt-oss-20b

# Opcion B: configuracion manual compatible con OpenAI.
# Si rellenas estos valores, tienen prioridad sobre el perfil.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# Activacion granular por fase del workflow.
# Recomendado: empezar solo con interpretation o planning.
LLM_USE_FOR_PLANNING=false
LLM_USE_FOR_CODEGEN=false
LLM_USE_FOR_INTERPRETATION=false

# Compatibilidad con nombres usados por SDKs OpenAI-compatible.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
