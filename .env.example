# Configuracion principal del LLM: openai/gpt-oss-20b servido sobre vLLM.
LLM_PROVIDER=openai-compatible

VLLM_BASE_URL=https://servidor-vllm.example/v1
VLLM_API_KEY=your_vllm_key_here
VLLM_MODEL=openai/gpt-oss-20b

# Alias compatibles con el SDK de OpenAI. Se pueden usar en lugar de VLLM_*.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b

# Opcional: alias genericos usados por el codigo.
# Si rellenas estos valores, tienen prioridad sobre OPENAI_API_KEY/OPENAI_MODEL,
# pero no sobre VLLM_*.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Solo si el endpoint configurado falla por certificado SSL local.
# OPENAI_VERIFY_SSL=false
